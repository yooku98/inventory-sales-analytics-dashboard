PORT=5000

# Required: secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Turso / libSQL. Leave unset to use a local SQLite file (file:local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production frontend origin allowed by CORS, e.g. https://your-app.vercel.app
CORS_ORIGIN=
